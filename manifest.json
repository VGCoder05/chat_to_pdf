{
  "manifest_version": 3,
  "name": "Chat Exporter",
  "version": "1.0",
  "description": "Export chats as PDF with custom styling.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "html2pdf.bundle.min.js"
      ]
    }
  ]
}